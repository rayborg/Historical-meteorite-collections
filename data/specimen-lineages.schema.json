{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmc:schema:specimen-lineages:4",
  "title": "Historical Meteorite Collection attested lineages and cross-catalog comparisons",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "sourceAttestedGroups", "relationships", "comparisonGroups"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "sourceAttestedGroups": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/sourceAttestedGroup" }
    },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "comparisonGroups": { "type": "array", "items": { "$ref": "#/$defs/comparisonGroup" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nonnegativeNumber": { "type": "number", "minimum": 0 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "source", "collectionSeries", "methodology", "counts"],
      "properties": {
        "schemaVersion": { "const": 4 },
        "scope": { "const": "attested-lineage-and-cross-catalog-comparisons" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogSchemaVersion", "recordCount", "catalogCount", "flattenedMassObservationCount", "inventoryObservationCount", "sourceClaimsSchemaVersion", "sourceClaimsContentSha256"],
          "properties": {
            "catalogSchemaVersion": { "const": 12 },
            "recordCount": { "type": "integer", "minimum": 0 },
            "catalogCount": { "type": "integer", "minimum": 0 },
            "flattenedMassObservationCount": { "type": "integer", "minimum": 0 },
            "inventoryObservationCount": { "type": "integer", "minimum": 0 },
            "sourceClaimsSchemaVersion": { "const": 1 },
            "sourceClaimsContentSha256": { "const": "141ed60b9560596ac8ab392babfc4af6e1d22921bacbf979d3b975e0fc2f20c2" }
          }
        },
        "collectionSeries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "catalogIds"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "catalogIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
            }
          }
        },
        "methodology": { "$ref": "#/$defs/methodology" },
        "counts": { "$ref": "#/$defs/counts" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryNormalization", "comparisonIdentity", "massThresholds", "comparisonGrouping", "ambiguityPolicy", "evidenceStrengthOrder", "nonAssertions"],
      "properties": {
        "inventoryNormalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unicode", "case", "whitespace", "hussEditionMarker"],
          "properties": {
            "unicode": { "const": "NFKC" },
            "case": { "const": "lowercase" },
            "whitespace": { "const": "removed" },
            "hussEditionMarker": { "const": "one leading (2) removed" }
          }
        },
        "comparisonIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolved", "unresolved"],
          "properties": {
            "resolved": { "type": "string", "minLength": 1 },
            "unresolved": { "type": "string", "minLength": 1 }
          }
        },
        "massThresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exactDifferenceGrams", "nearMinimumMassGrams", "nearMaximumRelativeDifference", "nearMaximumAbsoluteDifferenceGrams"],
          "properties": {
            "exactDifferenceGrams": { "const": 0 },
            "nearMinimumMassGrams": { "const": 10 },
            "nearMaximumRelativeDifference": { "const": 0.0025 },
            "nearMaximumAbsoluteDifferenceGrams": { "const": 2 }
          }
        },
        "comparisonGrouping": { "type": "string", "minLength": 1 },
        "ambiguityPolicy": { "type": "string", "minLength": 1 },
        "evidenceStrengthOrder": { "const": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"] },
        "nonAssertions": { "const": ["custody-chain", "ownership-transfer"] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipCount", "sameInventoryRelationshipCount", "comparisonGroupCount", "singletonComparisonGroupCount", "ambiguousComparisonGroupCount", "comparisonCandidateCount", "reviewedComparisonCandidateCount", "unreviewedComparisonCandidateCount", "exactMassComparisonCandidateCount", "nearMassComparisonCandidateCount", "metbullIdentityComparisonCandidateCount", "normalizedNameIdentityComparisonCandidateCount", "sameDesignationComparisonCandidateCount", "designationFamilyComparisonCandidateCount", "aggregateOrMultipleComparisonCandidateCount", "castComparisonCandidateCount", "identityResolvedInventoryCollisionCount", "omittedAmbiguousInventoryKeyCount", "comparisonCandidateEvidenceStrength", "comparisonGroupCardinalityDistribution", "catalogPairs", "sourceAttestedGroupCount", "sourceAttestedMemberOccurrenceCount", "sourceAttestedUniqueMemberCount"],
      "properties": {
        "relationshipCount": { "type": "integer", "minimum": 0 },
        "sameInventoryRelationshipCount": { "type": "integer", "minimum": 0 },
        "comparisonGroupCount": { "type": "integer", "minimum": 0 },
        "singletonComparisonGroupCount": { "type": "integer", "minimum": 0 },
        "ambiguousComparisonGroupCount": { "type": "integer", "minimum": 0 },
        "comparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "reviewedComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "unreviewedComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "exactMassComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "nearMassComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "metbullIdentityComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "normalizedNameIdentityComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "sameDesignationComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "designationFamilyComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "aggregateOrMultipleComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "castComparisonCandidateCount": { "type": "integer", "minimum": 0 },
        "identityResolvedInventoryCollisionCount": { "type": "integer", "minimum": 0 },
        "omittedAmbiguousInventoryKeyCount": { "type": "integer", "minimum": 0 },
        "sourceAttestedGroupCount": { "const": 21 },
        "sourceAttestedMemberOccurrenceCount": { "const": 89 },
        "sourceAttestedUniqueMemberCount": { "const": 87 },
        "comparisonCandidateEvidenceStrength": {
          "type": "object",
          "additionalProperties": false,
          "required": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"],
          "properties": {
            "multiple-matching-facts": { "type": "integer", "minimum": 0 },
            "two-matching-facts": { "type": "integer", "minimum": 0 },
            "limited-matching-evidence": { "type": "integer", "minimum": 0 }
          }
        },
        "comparisonGroupCardinalityDistribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidateCount", "groupCount"],
            "properties": {
              "candidateCount": { "type": "integer", "minimum": 1 },
              "groupCount": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "catalogPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalogPair", "sameInventoryCount", "comparisonGroupCount", "comparisonCandidateCount"],
            "properties": {
              "catalogPair": { "type": "string", "pattern": "^[a-z0-9-]+\\|[a-z0-9-]+$" },
              "sameInventoryCount": { "type": "integer", "minimum": 0 },
              "comparisonGroupCount": { "type": "integer", "minimum": 0 },
              "comparisonCandidateCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "sourceAttestedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalogId", "sourceSection", "claimType", "classification", "members", "reference", "printedPage"],
      "properties": {
        "id": { "type": "string", "pattern": "^victoria-land-1982-table-c-(?:00[1-9]|01[0-9]|02[01])$" },
        "catalogId": { "const": "victoria-land-1982" },
        "sourceSection": { "const": "Appendix Table C" },
        "claimType": { "const": "tentative-n-ary-group" },
        "classification": { "type": "string", "minLength": 1 },
        "members": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:ALHA|BTNA|DRPA|EETA|META|MBRA|PGPA|RKPA)[0-9]{5}$" } },
        "reference": { "type": "string", "minLength": 1 },
        "printedPage": { "const": 94 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship", "basis", "status", "displayName", "catalogPair", "collectionSeries", "identity", "evidence", "review", "observations"],
      "properties": {
        "id": { "type": "string", "pattern": "^same-inventory-lineage-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "relationship": { "const": "same-inventory" },
        "basis": { "const": "series-scoped-normalized-inventory-id" },
        "status": { "const": "established" },
        "displayName": { "type": "string", "minLength": 1 },
        "catalogPair": { "type": "string", "pattern": "^[a-z0-9-]+\\|[a-z0-9-]+$" },
        "collectionSeries": { "$ref": "#/$defs/collectionSeries" },
        "identity": { "const": null },
        "evidence": { "const": null },
        "review": { "const": null },
        "observations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "collectionSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inventoryId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inventoryId": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "basis", "displayName", "catalogPair", "identity", "massPair", "candidateCount", "candidates"],
      "properties": {
        "id": { "type": "string", "pattern": "^comparison-group-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "type": { "const": "comparison-only" },
        "basis": { "const": "reviewed-identity-and-reported-mass" },
        "displayName": { "type": "string", "minLength": 1 },
        "catalogPair": { "type": "string", "pattern": "^[a-z0-9-]+\\|[a-z0-9-]+$" },
        "identity": { "$ref": "#/$defs/identity" },
        "massPair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/massPair" } },
        "candidateCount": { "type": "integer", "minimum": 1 },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comparisonCandidate" } }
      }
    },
    "massPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "massGrams"],
      "properties": {
        "catalogId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "massGrams": { "$ref": "#/$defs/nonnegativeNumber" }
      }
    },
    "comparisonCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "v3CandidateId", "evidence", "review", "observations"],
      "properties": {
        "id": { "type": "string", "pattern": "^comparison-candidate-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "v3CandidateId": { "type": "string", "pattern": "^possible-lineage-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "review": { "$ref": "#/$defs/review" },
        "observations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "key", "canonicalName"],
      "properties": {
        "method": { "enum": ["metbull-code", "normalized-source-name"] },
        "key": { "type": "string", "minLength": 1 },
        "canonicalName": { "$ref": "#/$defs/nullableString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "massMatch", "absoluteDifferenceGrams", "relativeDifference", "sameDesignation", "designationFamily", "factCodes", "cautionCodes"],
      "properties": {
        "strength": { "enum": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"] },
        "massMatch": { "enum": ["exact", "near"] },
        "absoluteDifferenceGrams": { "$ref": "#/$defs/nonnegativeNumber" },
        "relativeDifference": { "$ref": "#/$defs/nonnegativeNumber" },
        "sameDesignation": { "type": "boolean" },
        "designationFamily": { "type": "boolean" },
        "factCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["shared-metbull-code", "shared-normalized-source-name", "exact-reported-mass", "near-reported-mass", "same-designation", "designation-family"] } },
        "cautionCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["normalized-name-identity", "near-reported-mass", "designation-differs-or-missing", "aggregate-or-multiple", "cast"] } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "reviewedOn", "publicNote", "citations"],
      "oneOf": [
        { "properties": { "status": { "const": "unreviewed" }, "outcome": { "const": null }, "reviewedOn": { "const": null }, "publicNote": { "const": null }, "citations": { "maxItems": 0 } } },
        { "properties": { "status": { "const": "reviewed" }, "outcome": { "enum": ["retain-as-possible", "not-supported"] }, "reviewedOn": { "type": "string", "format": "date" } } }
      ],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed"] },
        "outcome": { "enum": [null, "retain-as-possible", "not-supported"] },
        "reviewedOn": { "type": ["string", "null"], "format": "date", "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$" },
        "publicNote": { "type": ["string", "null"], "maxLength": 1000 },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "url": { "type": "string", "maxLength": 1000, "format": "uri", "pattern": "^https://(?!(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?::[0-9]{1,5})?(?:[/?#]|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#]|$)" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordId", "catalogId", "catalogLabel", "catalogYear", "recordModel", "designationPath", "massPath", "sourceRecordLabel", "sourceName", "canonicalName", "meteoriteCode", "designation", "massGrams", "kind", "count", "catalogSearchUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:inventory|mass)-observation-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "recordId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "catalogId": { "type": "string", "minLength": 1 },
        "catalogLabel": { "type": "string", "minLength": 1 },
        "catalogYear": { "type": "integer" },
        "recordModel": { "enum": ["specimen", "catalog-item", "catalog-number", "collection-entry", "table-a-specimen"] },
        "designationPath": { "type": ["string", "null"], "pattern": "^(?:designation|specimenId|holdings\\[[0-9]+\\]\\.designation)$" },
        "massPath": { "type": "string", "pattern": "^(?:weight\\.grams|holdings\\[[0-9]+\\]\\.(?:weight\\.grams|weights\\[[0-9]+\\]\\.grams))$" },
        "sourceRecordLabel": { "type": "string", "minLength": 1 },
        "sourceName": { "$ref": "#/$defs/nullableString" },
        "canonicalName": { "$ref": "#/$defs/nullableString" },
        "meteoriteCode": { "$ref": "#/$defs/nullableString" },
        "designation": { "$ref": "#/$defs/nullableString" },
        "massGrams": { "type": ["number", "null"], "minimum": 0 },
        "kind": { "type": ["string", "null"], "enum": ["specimen", "cast", "aggregate", null] },
        "count": { "type": ["integer", "null"], "minimum": 1 },
        "catalogSearchUrl": { "type": "string", "pattern": "^\\./index\\.html\\?catalog=[a-z0-9%_-]+&q=[^\\s#&]+#catalog$" }
      }
    }
  }
}
