{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmc:schema:specimen-lineages:2",
  "title": "Historical Meteorite Collection specimen-lineage relationships",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "relationships"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nonnegativeNumber": { "type": "number", "minimum": 0 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "source", "collectionSeries", "methodology", "counts"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "scope": { "const": "series-inventory-and-cross-source-candidates" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogSchemaVersion", "recordCount", "catalogCount", "flattenedMassObservationCount", "inventoryObservationCount"],
          "properties": {
            "catalogSchemaVersion": { "const": 7 },
            "recordCount": { "type": "integer", "minimum": 0 },
            "catalogCount": { "type": "integer", "minimum": 0 },
            "flattenedMassObservationCount": { "type": "integer", "minimum": 0 },
            "inventoryObservationCount": { "type": "integer", "minimum": 0 }
          }
        },
        "collectionSeries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "catalogIds"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "catalogIds": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
              }
            }
          }
        },
        "methodology": { "$ref": "#/$defs/methodology" },
        "counts": { "$ref": "#/$defs/counts" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryNormalization", "possibleMatchIdentity", "massThresholds", "ambiguityPolicy", "evidenceStrengthOrder", "nonAssertions"],
      "properties": {
        "inventoryNormalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unicode", "case", "whitespace", "hussEditionMarker"],
          "properties": {
            "unicode": { "const": "NFKC" },
            "case": { "const": "lowercase" },
            "whitespace": { "const": "removed" },
            "hussEditionMarker": { "const": "one leading (2) removed" }
          }
        },
        "possibleMatchIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolved", "unresolved"],
          "properties": {
            "resolved": { "type": "string", "minLength": 1 },
            "unresolved": { "type": "string", "minLength": 1 }
          }
        },
        "massThresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exactDifferenceGrams", "nearMinimumMassGrams", "nearMaximumRelativeDifference", "nearMaximumAbsoluteDifferenceGrams"],
          "properties": {
            "exactDifferenceGrams": { "const": 0 },
            "nearMinimumMassGrams": { "const": 10 },
            "nearMaximumRelativeDifference": { "const": 0.0025 },
            "nearMaximumAbsoluteDifferenceGrams": { "const": 2 }
          }
        },
        "ambiguityPolicy": { "type": "string", "minLength": 1 },
        "evidenceStrengthOrder": { "const": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"] },
        "nonAssertions": { "const": ["custody-chain", "ownership-transfer"] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipCount", "sameInventoryRelationshipCount", "possibleMatchRelationshipCount", "unreviewedPossibleMatchCount", "exactMassPossibleMatchCount", "nearMassPossibleMatchCount", "metbullIdentityPossibleMatchCount", "normalizedNameIdentityPossibleMatchCount", "sameDesignationPossibleMatchCount", "designationFamilyPossibleMatchCount", "aggregateOrMultiplePossibleMatchCount", "castPossibleMatchCount", "identityResolvedInventoryCollisionCount", "omittedAmbiguousInventoryKeyCount", "possibleMatchEvidenceStrength", "catalogPairs"],
      "properties": {
        "relationshipCount": { "type": "integer", "minimum": 0 },
        "sameInventoryRelationshipCount": { "type": "integer", "minimum": 0 },
        "possibleMatchRelationshipCount": { "type": "integer", "minimum": 0 },
        "unreviewedPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "exactMassPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "nearMassPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "metbullIdentityPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "normalizedNameIdentityPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "sameDesignationPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "designationFamilyPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "aggregateOrMultiplePossibleMatchCount": { "type": "integer", "minimum": 0 },
        "castPossibleMatchCount": { "type": "integer", "minimum": 0 },
        "identityResolvedInventoryCollisionCount": { "type": "integer", "minimum": 0 },
        "omittedAmbiguousInventoryKeyCount": { "type": "integer", "minimum": 0 },
        "possibleMatchEvidenceStrength": {
          "type": "object",
          "additionalProperties": false,
          "required": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"],
          "properties": {
            "multiple-matching-facts": { "type": "integer", "minimum": 0 },
            "two-matching-facts": { "type": "integer", "minimum": 0 },
            "limited-matching-evidence": { "type": "integer", "minimum": 0 }
          }
        },
        "catalogPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalogPair", "sameInventoryCount", "possibleMatchCount"],
            "properties": {
              "catalogPair": { "type": "string", "pattern": "^[a-z0-9-]+\\|[a-z0-9-]+$" },
              "sameInventoryCount": { "type": "integer", "minimum": 0 },
              "possibleMatchCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship", "basis", "status", "displayName", "catalogPair", "collectionSeries", "identity", "evidence", "review", "observations"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:same-inventory-lineage|possible-lineage)-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "relationship": { "enum": ["same-inventory", "possible-match"] },
        "basis": { "enum": ["series-scoped-normalized-inventory-id", "reviewed-identity-and-reported-mass"] },
        "status": { "enum": ["established", "possible"] },
        "displayName": { "type": "string", "minLength": 1 },
        "catalogPair": { "type": "string", "pattern": "^[a-z0-9-]+\\|[a-z0-9-]+$" },
        "collectionSeries": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "inventoryId"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "inventoryId": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "identity": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identity" }
          ]
        },
        "evidence": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/evidence" }
          ]
        },
        "review": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/review" }
          ]
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/observation" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "relationship": { "const": "same-inventory" },
            "basis": { "const": "series-scoped-normalized-inventory-id" },
            "status": { "const": "established" },
            "collectionSeries": { "not": { "type": "null" } },
            "identity": { "const": null },
            "evidence": { "const": null },
            "review": { "const": null }
          }
        },
        {
          "properties": {
            "relationship": { "const": "possible-match" },
            "basis": { "const": "reviewed-identity-and-reported-mass" },
            "status": { "const": "possible" },
            "collectionSeries": { "const": null },
            "identity": { "not": { "type": "null" } },
            "evidence": { "not": { "type": "null" } },
            "review": { "not": { "type": "null" } }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "key", "canonicalName"],
      "properties": {
        "method": { "enum": ["metbull-code", "normalized-source-name"] },
        "key": { "type": "string", "minLength": 1 },
        "canonicalName": { "$ref": "#/$defs/nullableString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "massMatch", "absoluteDifferenceGrams", "relativeDifference", "sameDesignation", "designationFamily", "factCodes", "cautionCodes"],
      "properties": {
        "strength": { "enum": ["multiple-matching-facts", "two-matching-facts", "limited-matching-evidence"] },
        "massMatch": { "enum": ["exact", "near"] },
        "absoluteDifferenceGrams": { "$ref": "#/$defs/nonnegativeNumber" },
        "relativeDifference": { "$ref": "#/$defs/nonnegativeNumber" },
        "sameDesignation": { "type": "boolean" },
        "designationFamily": { "type": "boolean" },
        "factCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["shared-metbull-code", "shared-normalized-source-name", "exact-reported-mass", "near-reported-mass", "same-designation", "designation-family"] }
        },
        "cautionCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["normalized-name-identity", "near-reported-mass", "designation-differs-or-missing", "aggregate-or-multiple", "cast"] }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "reviewedOn", "publicNote", "citations"],
      "oneOf": [
        {
          "properties": {
            "status": { "const": "unreviewed" },
            "outcome": { "const": null },
            "reviewedOn": { "const": null },
            "publicNote": { "const": null },
            "citations": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "status": { "const": "reviewed" },
            "outcome": { "enum": ["retain-as-possible", "not-supported"] },
            "reviewedOn": { "type": "string", "format": "date" }
          }
        }
      ],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed"] },
        "outcome": { "enum": [null, "retain-as-possible", "not-supported"] },
        "reviewedOn": { "type": ["string", "null"], "format": "date", "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$" },
        "publicNote": { "type": ["string", "null"], "maxLength": 1000 },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "url": {
          "type": "string",
          "maxLength": 1000,
          "format": "uri",
          "pattern": "^https://(?!(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?::[0-9]{1,5})?(?:[/?#]|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#]|$)"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordId", "catalogId", "catalogLabel", "catalogYear", "recordModel", "designationPath", "massPath", "sourceRecordLabel", "sourceName", "canonicalName", "meteoriteCode", "designation", "massGrams", "kind", "count", "catalogSearchUrl"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:inventory|mass)-observation-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "recordId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "catalogId": { "type": "string", "minLength": 1 },
        "catalogLabel": { "type": "string", "minLength": 1 },
        "catalogYear": { "type": "integer" },
        "recordModel": { "enum": ["specimen", "catalog-item", "catalog-number", "collection-entry"] },
        "designationPath": { "type": ["string", "null"], "pattern": "^(?:designation|holdings\\[[0-9]+\\]\\.designation)$" },
        "massPath": { "type": "string", "pattern": "^(?:weight\\.grams|holdings\\[[0-9]+\\]\\.(?:weight\\.grams|weights\\[[0-9]+\\]\\.grams))$" },
        "sourceRecordLabel": { "type": "string", "minLength": 1 },
        "sourceName": { "$ref": "#/$defs/nullableString" },
        "canonicalName": { "$ref": "#/$defs/nullableString" },
        "meteoriteCode": { "$ref": "#/$defs/nullableString" },
        "designation": { "$ref": "#/$defs/nullableString" },
        "massGrams": { "type": ["number", "null"], "minimum": 0 },
        "kind": { "type": ["string", "null"], "enum": ["specimen", "cast", "aggregate", null] },
        "count": { "type": ["integer", "null"], "minimum": 1 },
        "catalogSearchUrl": { "type": "string", "pattern": "^\\./index\\.html\\?catalog=[a-z0-9%_-]+&q=[^\\s#&]+#catalog$" }
      }
    }
  }
}
