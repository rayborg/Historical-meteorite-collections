{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmc:schema:specimen-lineage-reviews:1",
  "title": "Historical Meteorite Collection public specimen-lineage reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviews"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviews": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "url": {
          "type": "string",
          "maxLength": 1000,
          "format": "uri",
          "pattern": "^https://(?!(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?::[0-9]{1,5})?(?:[/?#]|$))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#]|$)"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "outcome", "reviewedOn", "publicNote", "citations"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^possible-lineage-[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "outcome": { "enum": ["retain-as-possible", "not-supported"] },
        "reviewedOn": { "type": "string", "format": "date", "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$" },
        "publicNote": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 1000 }
          ]
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    }
  }
}
