{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmc:schema:specimen-card-projections:1",
  "title": "Historical Meteorite Collection reviewed specimen-card display projections",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "projections"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "projections": {
      "type": "array",
      "minItems": 1699,
      "maxItems": 1699,
      "items": { "$ref": "#/$defs/projection" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "catalogSchemaVersion", "sourceRecordCount", "sourceCatalogSha256", "projectionCount", "projectedCardCount"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": { "const": "reviewed-specimen-card-display-projections" },
        "catalogSchemaVersion": { "const": 6 },
        "sourceRecordCount": { "const": 13542 },
        "sourceCatalogSha256": { "const": "3928a876a73c3ae74e9a822df0c2bded3f0cdfeb506874ebec4fc3877017a811" },
        "projectionCount": { "const": 1699 },
        "projectedCardCount": { "const": 6316 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentRecordId", "retainParentContext", "cards"],
      "properties": {
        "parentRecordId": {
          "type": "string",
          "pattern": "^obs-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "retainParentContext": { "type": "boolean" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdingPath", "massPath"],
      "properties": {
        "holdingPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]$"
        },
        "massPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.(?:weight|weights\\[(0|[1-9][0-9]*)\\])\\.grams$"
        }
      }
    }
  }
}
