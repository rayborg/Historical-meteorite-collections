{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmc:schema:specimen-card-projections:5",
  "title": "Historical Meteorite Collection reviewed atomic specimen-card display projections",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "projections"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "projections": {
      "type": "array",
      "minItems": 3407,
      "maxItems": 3407,
      "items": {
        "$ref": "#/$defs/projection"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scope",
        "catalogSchemaVersion",
        "sourceRecordCount",
        "sourceCatalogSha256",
        "projectionCount",
        "atomicCardCount",
        "sourceContextCardCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": 5
        },
        "scope": {
          "const": "reviewed-atomic-specimen-card-display-projections"
        },
        "catalogSchemaVersion": {
          "const": 12
        },
        "sourceRecordCount": {
          "const": 19553
        },
        "sourceCatalogSha256": {
          "const": "cf429e6660f00272f2f81fe69bac81c891f41574bbfff6e6bb46499d2d0672b4"
        },
        "projectionCount": {
          "const": 3407
        },
        "atomicCardCount": {
          "const": 8410
        },
        "sourceContextCardCount": {
          "const": 2877
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentRecordId",
        "cards"
      ],
      "properties": {
        "parentRecordId": {
          "type": "string",
          "pattern": "^obs-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "card": {
      "oneOf": [
        {
          "$ref": "#/$defs/clauseCard"
        },
        {
          "$ref": "#/$defs/qualitativeClauseCard"
        },
        {
          "$ref": "#/$defs/repeatedClauseCard"
        },
        {
          "$ref": "#/$defs/componentCard"
        }
      ]
    },
    "clauseCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdingPath",
        "clause",
        "massPath"
      ],
      "properties": {
        "holdingPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]$"
        },
        "clause": {
          "$ref": "#/$defs/clause"
        },
        "massPath": {
          "$ref": "#/$defs/nullableMassPath"
        }
      }
    },
    "qualitativeClauseCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdingPath",
        "clause",
        "massPath",
        "qualitativeWeightEvidence"
      ],
      "properties": {
        "holdingPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]$"
        },
        "clause": {
          "$ref": "#/$defs/clause"
        },
        "massPath": {
          "type": "null"
        },
        "qualitativeWeightEvidence": {
          "$ref": "#/$defs/qualitativeWeightEvidence"
        }
      }
    },
    "componentCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdingPath",
        "componentPath",
        "massPath"
      ],
      "properties": {
        "holdingPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]$"
        },
        "componentPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.weights\\[(0|[1-9][0-9]*)\\]$"
        },
        "massPath": {
          "$ref": "#/$defs/componentMassPath"
        }
      }
    },
    "repeatedClauseCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdingPath",
        "clause",
        "massPath",
        "repeatedMass"
      ],
      "properties": {
        "holdingPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]$"
        },
        "clause": {
          "$ref": "#/$defs/clause"
        },
        "massPath": {
          "type": "null"
        },
        "repeatedMass": {
          "$ref": "#/$defs/repeatedMass"
        }
      }
    },
    "repeatedMass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valuePath",
        "countPath",
        "totalPath",
        "occurrence",
        "occurrenceCount"
      ],
      "properties": {
        "valuePath": {
          "$ref": "#/$defs/componentMassPath"
        },
        "countPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.count$"
        },
        "totalPath": {
          "$ref": "#/$defs/componentMassPath"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "qualitativeWeightEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "statement"
      ],
      "properties": {
        "type": {
          "const": "qualitative"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nullableMassPath": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/massPath"
        }
      ]
    },
    "massPath": {
      "type": "string",
      "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.(?:weight|weights\\[(0|[1-9][0-9]*)\\])\\.grams$"
    },
    "componentMassPath": {
      "type": "string",
      "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.weights\\[(0|[1-9][0-9]*)\\]\\.grams$"
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textPath",
        "start",
        "end"
      ],
      "properties": {
        "textPath": {
          "type": "string",
          "pattern": "^holdings\\[(0|[1-9][0-9]*)\\]\\.(?:description|designation)$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
